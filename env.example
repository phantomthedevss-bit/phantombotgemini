# ---- Required ----
# From @BotFather (use a DIFFERENT bot token for Render and for Vercel)
BOT_TOKEN=123456789:AAExampleTokenFromBotFather

# From https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Any random string (letters/numbers/_/-). Protects your webhook and cron URL from strangers.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
WEBHOOK_SECRET=put_a_long_random_string_here

# ---- Database (needed for permanent memory, reminders, daily briefing, saved facts) ----
# Free at https://upstash.com -> Create Database (Redis) -> REST API section.
# (If you add Upstash through the Vercel Storage tab, it creates KV_REST_API_URL / KV_REST_API_TOKEN: also supported.)
UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_rest_token

# ---- Optional ----
# Comma-separated Telegram user IDs allowed to use the bot (send /id to the bot to get yours).
# Leave empty to let anyone use it (not recommended: strangers would burn your Gemini quota).
ALLOWED_USER_IDS=

# Main model and a fallback used if the main one errors / rate-limits
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# How many back-and-forth turns the bot remembers per chat
MAX_HISTORY_TURNS=12

# Country for news headlines (2-letter code, e.g. US, GB, NG, KE, IN, ZA). Default US.
NEWS_COUNTRY=US

# Separate password for the cron URL (defaults to WEBHOOK_SECRET if empty)
CRON_SECRET=

# Optional live web search (free key at https://tavily.com). Adds a "web_search" ability.
TAVILY_API_KEY=

# Optional: max AI messages per user per day (protects your free Gemini quota). 0 or empty = unlimited.
DAILY_MESSAGE_LIMIT=
